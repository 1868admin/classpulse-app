{
  "name": "ClassMembership",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "class_type": {
      "type": "string",
      "enum": [
        "homeroom",
        "subject"
      ]
    },
    "class_id": {
      "type": "string"
    },
    "class_name": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "student_id_no": {
      "type": "string"
    },
    "year_group_id": {
      "type": "string"
    },
    "year_group_name": {
      "type": "string"
    },
    "academic_year_id": {
      "type": "string"
    }
  },
  "required": [
    "school_id",
    "class_type",
    "class_id",
    "student_id"
  ],
  "rls": {
    "read": {
      "data.school_id": "{{user.data.school_id}}"
    },
    "create": {
      "data.school_id": "{{user.data.school_id}}"
    },
    "update": {
      "data.school_id": "{{user.data.school_id}}"
    },
    "delete": {
      "data.school_id": "{{user.data.school_id}}"
    }
  }
}