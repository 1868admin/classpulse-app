{
  "name": "TeacherAvailability",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "member_id": {
      "type": "string"
    },
    "academic_year_id": {
      "type": "string"
    },
    "day_name": {
      "type": "string"
    },
    "period_number": {
      "type": "number"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "is_available": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "school_id",
    "member_id",
    "academic_year_id",
    "day_name",
    "period_number"
  ],
  "rls": {
    "read": {
      "data.school_id": "{{user.data.school_id}}"
    },
    "create": {
      "data.school_id": "{{user.data.school_id}}"
    },
    "update": {
      "data.school_id": "{{user.data.school_id}}"
    },
    "delete": {
      "data.school_id": "{{user.data.school_id}}"
    }
  }
}
