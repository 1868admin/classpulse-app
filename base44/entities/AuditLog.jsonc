{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "actor_name": {
      "type": "string"
    },
    "actor_email": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "entity_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "details": {
      "type": "string"
    }
  },
  "required": [
    "school_id",
    "action"
  ],
  "rls": {
    "read": {
      "data.school_id": "{{user.data.school_id}}"
    },
    "create": {
      "data.school_id": "{{user.data.school_id}}"
    },
    "update": false,
    "delete": false
  }
}