{
  "name": "InvigilationRequirement",
  "type": "object",
  "properties": {
    "school_id": { "type": "string" },
    "academic_year_id": { "type": "string" },
    "examination_id": { "type": "string" },
    "required_supervisors": { "type": "number", "default": 2 },
    "created_by": { "type": "string" },
    "updated_by": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "required": ["school_id", "academic_year_id", "examination_id", "required_supervisors"],
  "rls": {
    "read": { "data.school_id": "{{user.data.school_id}}" },
    "create": { "data.school_id": "{{user.data.school_id}}" },
    "update": { "data.school_id": "{{user.data.school_id}}" },
    "delete": { "data.school_id": "{{user.data.school_id}}" }
  }
}
