{
  "name": "ExaminationTimetableEntry",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "academic_year_id": {
      "type": "string"
    },
    "exam_name": {
      "type": "string"
    },
    "class_type": {
      "type": "string",
      "enum": [
        "homeroom",
        "subject"
      ]
    },
    "class_id": {
      "type": "string"
    },
    "class_name": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "exam_date": {
      "type": "string"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "room": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    }
  },
  "required": [
    "school_id",
    "academic_year_id",
    "exam_name",
    "class_type",
    "class_id",
    "exam_date",
    "start_time",
    "end_time",
    "room",
    "status"
  ],
  "rls": {
    "read": {
      "data.school_id": "{{user.data.school_id}}"
    },
    "create": {
      "data.school_id": "{{user.data.school_id}}"
    },
    "update": {
      "data.school_id": "{{user.data.school_id}}"
    },
    "delete": {
      "data.school_id": "{{user.data.school_id}}"
    }
  }
}
